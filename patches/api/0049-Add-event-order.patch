     /**
      * Enables the specified plugin
diff --git a/src/main/java/org/bukkit/plugin/RegisteredListener.java b/src/main/java/org/bukkit/plugin/RegisteredListener.java
index 3b3d9642a8d63798dc28f2f8df77f0466451cbff..dbde9f3d272038ba34a06546c9218a7453defe14 100644
--- a/src/main/java/org/bukkit/plugin/RegisteredListener.java
+++ b/src/main/java/org/bukkit/plugin/RegisteredListener.java
@@ -13,17 +13,23 @@ import org.jetbrains.annotations.NotNull;
 public class RegisteredListener {
     private final Listener listener;
     private final EventPriority priority;
+    //Prism start - add event order
+    private final int order;
+    //Prism end - add event order
     private final Plugin plugin;
     private final EventExecutor executor;
     private final boolean ignoreCancelled;
 
-    public RegisteredListener(@NotNull final Listener listener, @NotNull final EventExecutor executor, @NotNull final EventPriority priority, @NotNull final Plugin plugin, final boolean ignoreCancelled) {
+    //Prism start - add event order
+    public RegisteredListener(@NotNull final Listener listener, @NotNull final EventExecutor executor, @NotNull final EventPriority priority, final int order, @NotNull final Plugin plugin, final boolean ignoreCancelled) {
         this.listener = listener;
         this.priority = priority;
         this.plugin = plugin;
         this.executor = executor;
         this.ignoreCancelled = ignoreCancelled;
+        this.order = order;
     }
+    //Prism end - add event order
 
     /**
      * Gets the listener for this registration
@@ -55,6 +61,12 @@ public class RegisteredListener {
         return priority;
     }
 
+    //Prism start - add event order
+    public int getOrder() {
+        return order;
+    }
+    //Prism end - add event order
+
     /**
      * Calls the event executor
      *
@@ -97,6 +109,7 @@ public class RegisteredListener {
             + "\", listener=\"" + this.listener
             + "\", executor=\"" + this.executor
             + "\", priority=\"" + this.priority.name() + " (" + this.priority.getSlot() + ")"
+            + ", order=\"" + this.order + "\""
             + "\", ignoringCancelled=" + this.ignoreCancelled
             + "}";
     }
diff --git a/src/main/java/org/bukkit/plugin/SimplePluginManager.java b/src/main/java/org/bukkit/plugin/SimplePluginManager.java
index e8ba4f1108f2548a487877027e37d81fc150e042..124f29dd6db4dfbfaac338730b8fdcba49188d5c 100644
--- a/src/main/java/org/bukkit/plugin/SimplePluginManager.java
+++ b/src/main/java/org/bukkit/plugin/SimplePluginManager.java
@@ -696,10 +696,11 @@ public final class SimplePluginManager implements PluginManager {
     }
 
     @Override
-    public void registerEvent(@NotNull Class<? extends Event> event, @NotNull Listener listener, @NotNull EventPriority priority, @NotNull EventExecutor executor, @NotNull Plugin plugin) {
-        registerEvent(event, listener, priority, executor, plugin, false);
+    public void registerEvent(@NotNull Class<? extends Event> event, @NotNull Listener listener, @NotNull EventPriority priority, final int order, @NotNull EventExecutor executor, @NotNull Plugin plugin) {
+        registerEvent(event, listener, priority, order, executor, plugin, false);
     }
 
+    //Prism start - add event order
     /**
      * Registers the given event to the specified listener using a directly
      * passed EventExecutor
@@ -707,30 +708,27 @@ public final class SimplePluginManager implements PluginManager {
      * @param event Event class to register
      * @param listener PlayerListener to register
      * @param priority Priority of this event
+     * @param order order of this event
      * @param executor EventExecutor to register
      * @param plugin Plugin to register
      * @param ignoreCancelled Do not call executor if event was already
      *     cancelled
      */
     @Override
-    public void registerEvent(@NotNull Class<? extends Event> event, @NotNull Listener listener, @NotNull EventPriority priority, @NotNull EventExecutor executor, @NotNull Plugin plugin, boolean ignoreCancelled) {
+    public void registerEvent(@NotNull Class<? extends Event> event, @NotNull Listener listener, @NotNull EventPriority priority, final int order, @NotNull EventExecutor executor, @NotNull Plugin plugin, boolean ignoreCancelled) {
         Preconditions.checkArgument(listener != null, "Listener cannot be null");
         Preconditions.checkArgument(priority != null, "Priority cannot be null");
         Preconditions.checkArgument(executor != null, "Executor cannot be null");
         Preconditions.checkArgument(plugin != null, "Plugin cannot be null");
-        if (true) {this.paperPluginManager.registerEvent(event, listener, priority, executor, plugin, ignoreCancelled); return;} // Paper
+        if (true) {this.paperPluginManager.registerEvent(event, listener, priority, order, executor, plugin, ignoreCancelled); return;} // Paper
 
         if (!plugin.isEnabled()) {
             throw new IllegalPluginAccessException("Plugin attempted to register " + event + " while not enabled");
         }
 
         executor = new co.aikar.timings.TimedEventExecutor(executor, plugin, null, event); // Paper
-        if (false) { // Spigot - RL handles useTimings check now // Paper
-            getEventListeners(event).register(new TimedRegisteredListener(listener, executor, priority, plugin, ignoreCancelled));
-        } else {
-            getEventListeners(event).register(new RegisteredListener(listener, executor, priority, plugin, ignoreCancelled));
-        }
     }
+    //Prism end - add event order
 
     @NotNull
     private HandlerList getEventListeners(@NotNull Class<? extends Event> type) {
diff --git a/src/main/java/org/bukkit/plugin/TimedRegisteredListener.java b/src/main/java/org/bukkit/plugin/TimedRegisteredListener.java
