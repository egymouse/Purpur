Subject: [PATCH] Add event order


diff --git a/src/main/java/org/bukkit/event/EventHandler.java b/src/main/java/org/bukkit/event/EventHandler.java
index cc06f480b788b19d4799ba0dcf53b3640059f023..478379b7f170815162c35d545806c5560a4382d6 100644
--- a/src/main/java/org/bukkit/event/EventHandler.java
+++ b/src/main/java/org/bukkit/event/EventHandler.java
@@ -29,6 +29,10 @@ public @interface EventHandler {
      */
     EventPriority priority() default EventPriority.NORMAL;
 
+    //Prism start - add event order
+    int order() default 0;
+    //Prism end - add event order
+
     /**
      * Define if the handler ignores a cancelled event.
      * <p>
diff --git a/src/main/java/org/bukkit/event/HandlerList.java b/src/main/java/org/bukkit/event/HandlerList.java
index 2292bd460ce2be113beb4ba6b4eb19350060f01c..0f136d35378b5a37b7ba957e1941dbc3db94db38 100644
--- a/src/main/java/org/bukkit/event/HandlerList.java
+++ b/src/main/java/org/bukkit/event/HandlerList.java
@@ -193,7 +193,11 @@ public class HandlerList {
         if (handlers != null) return; // don't re-bake when still valid
         List<RegisteredListener> entries = new ArrayList<RegisteredListener>();
         for (Entry<EventPriority, ArrayList<RegisteredListener>> entry : handlerslots.entrySet()) {
-            entries.addAll(entry.getValue());
+            //Prism start - add event order
+            ArrayList<RegisteredListener> list = new ArrayList<>(entry.getValue());
+            list.sort(java.util.Comparator.comparingInt(RegisteredListener::getOrder));
+            entries.addAll(list);
+            //Prism end - add event order
         }
         handlers = entries.toArray(new RegisteredListener[entries.size()]);
     }
